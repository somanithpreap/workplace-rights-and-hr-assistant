# Copy this file to .env and put YOUR OWN key in it. Never commit .env.
GEMINI_API_KEY=your-key-here
# Exact model IDs from Google AI Studio (Model dropdown -> Get code)
CHAT_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
# gemini = real calls, mock = fake answers without a key (for testing plumbing)
LLM_MODE=gemini
# bm25 | dense | hybrid   (dense/hybrid need: python search.py --build)
SEARCH_MODE=hybrid
